# Copy to .env.local for local development. Never commit real values.

# Supabase (Project Settings -> API). Use a project dedicated to FindSeek.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the job ingestion route to write shared job listings.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Adzuna job search API (developer.adzuna.com). Free tier: 2,500 calls/month;
# commercial use needs a licence after the 14-day trial.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Comma-separated ISO country codes to pull jobs for. FindSeek launches India-only.
JOB_COUNTRIES=in

# Extra company job boards to read, as "slug:Company Name" pairs separated by commas.
# Check each board loads at boards.greenhouse.io/<slug> or jobs.lever.co/<slug> first.
GREENHOUSE_BOARDS=
LEVER_SITES=

# Shared secret that protects the job ingestion endpoint (cron).
CRON_SECRET=

# Who may review reports of bad listings at /ops/reports (comma-separated email addresses; they must
# sign in with a confirmed email). Leave empty to switch the review page off.
OPERATOR_EMAILS=

# An employer's opening is trusted as that company's only when its account signs in with an email on
# the company's own domain (priya@razorpay.com for Razorpay), never a free mailbox. For a legitimate
# employer whose domain differs from its name, add the domain here after you have vetted it:
# comma-separated, e.g. "acmetech.in, beta.co.in". Your own OPERATOR_EMAILS account can always post.
TRUSTED_EMPLOYER_DOMAINS=

# Email for hiring outcome emails (resend.com). EMAIL_FROM must be a verified sender,
# e.g. "FindSeek <hiring@your-domain.com>". Without these, drafts can be written but not sent.
RESEND_API_KEY=
EMAIL_FROM=
